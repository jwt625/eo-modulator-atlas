# Override the aggressive PlayGround root .gitignore for this project's tracked artifacts.
# This project tracks its database (CSV), staging outputs, and per-source reference metadata
# (source.json, crossref.json) plus cached source PDFs. Extracted text/figures stay local.
!*.json
!*.csv
!*.txt
!*.pdf
!*.png
!*.svg
!*.html

# Local-only: extracted text and figures (rights are source-specific).
references/*/source.html
references/*/text.md
references/*/figures/
references/_inbox/*
!references/_inbox/README.md

# Local-only: private path mapping, generated caches, build output, logs.
# (kept after the negations above so they win)
data/_staging/candidates_seed_local_paths_private.csv
.venv/
node_modules/
app/build/
app/.svelte-kit/
app/static/sims/
logs/
.request-tmp/
__pycache__/
.ruff_cache/
.mypy_cache/
.pytest_cache/
