{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eo-atlas.local/schema/sim.schema.json",
  "title": "EO atlas simulation inputs v1",
  "description": "Cross-section input structure. Runtime validation additionally checks positive material tensors, geometry coverage, references, voltage normalization, numerical limits, model/field consistency of the line block and stage completeness (EO arm windows, RF loss declarations) when a stage is requested. loaded_line and eo_response are recognised but not implemented.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "materials",
    "geometry"
  ],
  "properties": {
    "schema": {
      "const": "eo-atlas.sim/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "paper_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "repro_grade": {
      "enum": [
        "A",
        "B"
      ]
    },
    "validation_status": {
      "enum": [
        "unvalidated",
        "analytic_gates_pass",
        "literature_regression",
        "cross_solver"
      ]
    },
    "chain": {
      "type": "array",
      "items": {
        "enum": [
          "electrostatics",
          "optical_mode",
          "eo_overlap",
          "rf_line",
          "loaded_line",
          "eo_response"
        ]
      }
    },
    "materials": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/material"
      }
    },
    "geometry": {
      "$ref": "#/$defs/geometry"
    },
    "alt_geometries": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/geometry"
      }
    },
    "optics": {
      "type": "object",
      "properties": {
        "metal_in_window": {
          "enum": [
            "reject",
            "absent",
            "pec_scalar"
          ],
          "default": "reject",
          "description": "Explicit scalar optical metal policy. Absent and PEC are sensitivity limits, not real-metal loss models."
        },
        "wavelength_nm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "polarization": {
          "enum": [
            "TE",
            "TM",
            "quasi-TE",
            "quasi-TM"
          ]
        },
        "mode_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "group_index_from": {
          "enum": [
            "fixed",
            "finite_difference_wavelength"
          ]
        },
        "ng_fixed": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "eo_axis": {
          "enum": [
            "auto"
          ]
        },
        "eo": {
          "type": "object",
          "additionalProperties": false,
          "description": "EO overlap inputs (required by the eo_overlap stage). Arm windows are explicit; terminal_drive is a label (V_t is the full terminal difference) and must agree with line.differential.",
          "required": [
            "arm_drive",
            "terminal_drive",
            "arm_windows"
          ],
          "properties": {
            "arm_drive": {
              "enum": [
                "single_arm",
                "two_arm_field_resolved"
              ]
            },
            "terminal_drive": {
              "enum": [
                "single_ended",
                "differential"
              ]
            },
            "arm_windows": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "A"
              ],
              "properties": {
                "A": {
                  "$ref": "#/$defs/window"
                },
                "B": {
                  "$ref": "#/$defs/window"
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "arm_drive": {
                    "const": "two_arm_field_resolved"
                  }
                }
              },
              "then": {
                "properties": {
                  "arm_windows": {
                    "required": [
                      "A",
                      "B"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "arm_drive": {
                    "const": "single_arm"
                  }
                }
              },
              "then": {
                "properties": {
                  "arm_windows": {
                    "not": {
                      "required": [
                        "B"
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "wavelength_nm",
        "polarization",
        "group_index_from"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "group_index_from": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "required": [
              "ng_fixed"
            ],
            "properties": {
              "ng_fixed": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "class"
        ],
        "properties": {
          "class": {
            "enum": [
              "paper_exact",
              "figure_digitized",
              "project_inference",
              "standard_reference",
              "unknown"
            ]
          },
          "locator": {
            "type": "string"
          },
          "citation": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "missing": {
      "type": "array"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "line": {
      "type": "object",
      "properties": {
        "differential": {
          "type": "boolean"
        },
        "loading": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "none",
                "periodic_t_rail"
              ]
            },
            "period_um": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "loaded_length_um": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "loaded_cross_section": {
              "type": [
                "string",
                "null"
              ]
            },
            "unloaded_cross_section": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "periodic_t_rail"
                  }
                }
              },
              "then": {
                "required": [
                  "period_um",
                  "loaded_length_um",
                  "unloaded_cross_section"
                ],
                "properties": {
                  "period_um": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "loaded_length_um": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unloaded_cross_section": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "length_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "electrode length per arm (mm); vpi_dc_v = VpiL / length"
        },
        "source_ohm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "load_ohm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "conductor_loss_model": {
          "enum": [
            "none",
            "rprime_reference",
            "skin_effect_geometry_factor",
            "skin_effect_perimeter",
            "skin_effect_wheeler",
            "from_paper_alpha"
          ],
          "description": "Explicit conductor loss model; skin_effect_wheeler uses recessed-geometry solves (DevLog-012 item 4)."
        },
        "dielectric_loss_model": {
          "enum": [
            "none",
            "tan_delta_regions"
          ],
          "description": "Required by rf_line unless from_paper_alpha. tan_delta_regions needs tan_delta_rf (or a dielectric sigma_Sm) on every region material."
        },
        "include_internal_inductance": {
          "type": "boolean"
        },
        "r_pul_ref_ohm_per_m": {
          "type": "number",
          "minimum": 0
        },
        "r_pul_ref_ghz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "conductor_k_per_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "integral |J_s|^2 dl / I^2 (1/m) for skin_effect_geometry_factor"
        },
        "perimeters_cover_carrying_surfaces": {
          "type": "boolean"
        },
        "rf_loss_table": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "f_ghz",
                  "alpha_db_per_cm"
                ],
                "properties": {
                  "f_ghz": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "alpha_db_per_cm": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          ],
          "description": "Paper attenuation input (from_paper_alpha); never an independent prediction; needs a provenance locator."
        },
        "rf_loss_law": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "alpha0_db_per_cm_per_sqrt_ghz"
              ],
              "properties": {
                "alpha0_db_per_cm_per_sqrt_ghz": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "sweep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "f_start_ghz",
        "f_stop_ghz",
        "n_points"
      ],
      "properties": {
        "f_start_ghz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "f_stop_ghz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "n_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4001
        }
      }
    }
  },
  "$defs": {
    "interval": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "window": {
      "type": "object",
      "required": [
        "x_um",
        "y_um"
      ],
      "properties": {
        "x_um": {
          "$ref": "#/$defs/interval"
        },
        "y_um": {
          "$ref": "#/$defs/interval"
        }
      },
      "additionalProperties": false
    },
    "shape": {
      "type": "object",
      "required": [
        "name",
        "material"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "material": {
          "type": "string",
          "minLength": 1
        },
        "rect": {
          "$ref": "#/$defs/window"
        },
        "polygon_um": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/interval"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "rect"
          ],
          "not": {
            "required": [
              "polygon_um"
            ]
          }
        },
        {
          "required": [
            "polygon_um"
          ],
          "not": {
            "required": [
              "rect"
            ]
          }
        }
      ]
    },
    "geometry": {
      "type": "object",
      "required": [
        "domain",
        "regions",
        "electrodes"
      ],
      "properties": {
        "domain": {
          "$ref": "#/$defs/window"
        },
        "symmetry": {
          "enum": [
            "none",
            "x_mirror_even",
            "x_mirror_odd"
          ]
        },
        "mirror_x_um": {
          "type": "number"
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shape"
          }
        },
        "electrodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/shape"
              },
              {
                "required": [
                  "weight"
                ],
                "properties": {
                  "weight": {
                    "type": "number"
                  }
                }
              }
            ]
          }
        },
        "optical_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/window"
            },
            {
              "type": "null"
            }
          ]
        },
        "mesh": {
          "$ref": "#/$defs/mesh"
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "left": {
              "enum": [
                "neumann",
                "dirichlet"
              ]
            },
            "right": {
              "enum": [
                "neumann",
                "dirichlet"
              ]
            },
            "top": {
              "enum": [
                "neumann",
                "dirichlet"
              ]
            },
            "bottom": {
              "enum": [
                "neumann",
                "dirichlet"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "properties": {
        "conductor": {
          "type": "boolean"
        },
        "eps_r": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "object",
              "required": [
                "perp",
                "par"
              ],
              "additionalProperties": false,
              "properties": {
                "perp": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "par": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "type": "object",
              "required": [
                "xx",
                "yy",
                "zz"
              ],
              "additionalProperties": false,
              "properties": {
                "xx": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "yy": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "zz": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        },
        "n": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "n_o": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "n_e": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sigma_Sm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crystal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cut",
            "propagation"
          ],
          "properties": {
            "cut": {
              "type": "string"
            },
            "propagation": {
              "type": "string"
            },
            "rotation_deg": {
              "type": "number",
              "description": "CCW rotation of the lab frame about the propagation axis seen from +z: x' = cos t x + sin t y (fixed sense 2026-10-07)"
            }
          }
        },
        "r_pm_per_v": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "voigt"
              ],
              "properties": {
                "voigt": {
                  "type": "array",
                  "minItems": 6,
                  "maxItems": 6,
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "r13": {
                  "type": "number"
                },
                "r22": {
                  "type": "number"
                },
                "r33": {
                  "type": "number"
                },
                "r51": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "tan_delta_rf": {
          "type": "number",
          "minimum": 0,
          "description": "RF loss tangent; absent = unknown (never zero)"
        },
        "dispersion": {
          "type": "string",
          "description": "Library dispersion key (defaults to the material name when the library has it)"
        },
        "thickness_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "n_complex": {
          "description": "Reserved; not used by the engine (real-metal optics is not modelled)"
        }
      },
      "if": {
        "required": [
          "conductor"
        ],
        "properties": {
          "conductor": {
            "const": true
          }
        }
      },
      "else": {
        "required": [
          "eps_r"
        ]
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "metric",
        "value"
      ],
      "properties": {
        "metric": {
          "enum": [
            "vpi_l_dc_vcm",
            "vpi_dc_v",
            "n_eff",
            "ng_opt",
            "n_rf",
            "z0_ohm",
            "c_pul_pf_per_m",
            "c0_pul_pf_per_m",
            "l_pul_nh_per_m",
            "rf_loss_db_per_cm",
            "eo_rolloff_db",
            "bw3db_ghz",
            "bw6db_ghz",
            "optical_confinement_in_region"
          ]
        },
        "value": {
          "type": "number"
        },
        "tol_abs": {
          "type": "number",
          "minimum": 0
        },
        "tol_rel": {
          "type": "number",
          "minimum": 0
        },
        "at_ghz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source": {
          "type": "object",
          "properties": {
            "comparable": {
              "type": "boolean",
              "description": "false: never evaluated"
            }
          }
        },
        "vpi_convention": {
          "enum": [
            "per_arm_phase_shifter",
            "mzm_push_pull",
            "mzm_series_push_pull",
            "mzm_differential",
            "mzm_single_arm",
            "resonance_tuning_derived",
            "unspecified"
          ],
          "description": "Required for a Vpi target to be evaluated; must match the engine drive convention (no silent conversion). mzm_differential = MZM V_pi against the full terminal difference V+ - V- (data/schema/devices.schema.yaml convention (q), 2026-10-07), the engine V_t."
        }
      },
      "anyOf": [
        {
          "required": [
            "tol_abs"
          ]
        },
        {
          "required": [
            "tol_rel"
          ]
        }
      ],
      "additionalProperties": false
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_edge_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "electrode_edge_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "electrode_face_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "window_edge_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "far_edge_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_edge_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "grade": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "grade_far": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "grade_corner": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_angle_bound": {
          "type": "number",
          "minimum": 1
        },
        "max_vertices": {
          "type": "integer",
          "minimum": 4,
          "maximum": 80000,
          "default": 80000
        },
        "regions": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
